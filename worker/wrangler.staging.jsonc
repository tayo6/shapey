{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shapey-multiplayer-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [],
  "vars": {
    "STAGING_ALLOWED_ORIGINS": "https://shapey-audience-preview.hellohuman100.workers.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
