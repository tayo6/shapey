{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shapey-multiplayer-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [],
  "vars": {
    "ENVIRONMENT": "staging"
  },
  "ratelimits": [
    { "name": "DIRECTORY_READ_LIMITER", "namespace_id": "20261005", "simple": { "limit": 60, "period": 60 } },
    { "name": "ROOM_INFO_LIMITER", "namespace_id": "20261006", "simple": { "limit": 120, "period": 60 } },
    { "name": "WEBSOCKET_UPGRADE_LIMITER", "namespace_id": "20261007", "simple": { "limit": 120, "period": 60 } },
    { "name": "ROOM_CREATE_BURST_LIMITER", "namespace_id": "20261008", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
