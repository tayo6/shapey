{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shapey-multiplayer",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "ratelimits": [
    { "name": "DIRECTORY_READ_LIMITER", "namespace_id": "20261001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ROOM_INFO_LIMITER", "namespace_id": "20261002", "simple": { "limit": 120, "period": 60 } },
    { "name": "WEBSOCKET_UPGRADE_LIMITER", "namespace_id": "20261003", "simple": { "limit": 120, "period": 60 } },
    { "name": "ROOM_CREATE_BURST_LIMITER", "namespace_id": "20261004", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
