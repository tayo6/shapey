From ac9df3f1342477bbc261b45c1126f91551a53d9b Mon Sep 17 00:00:00 2001
From: Shapey Refactor <refactor@local>
Date: Fri, 23 Oct 2026 05:07:27 +0000
Subject: [PATCH 2/4] De-duplicate staging: run the shared src modules via
 SHAPEY_ENV

staging/main.js, staging/memes.js and staging/loading-bar.js were a
~3,900-line copy of the production code that had already drifted behind
(missing rules-driven win targets, the hazard-commentary suppression and
the boardSize restart). staging/index.html now loads the same src/
modules as the home page and only injects
window.SHAPEY_ENV = { staging: true, memesStandardWindow: 3 } before
they run:

- staging relaxes the local-Worker ?api= override to any host
  (src/config.js); the default API (the Cloudflare Worker) is unchanged
- meme commentary fires one per 3 attempts instead of 4 (src/memes.js
  reads the override; every other page and Node keep the default)
- the board-size picker shows the 'Staging test' prefix (STAGING flag)
- staging inherits current production behavior everywhere else

The forked copies are deleted; staging/audience.* and demo-room.js are
standalone pages and stay as they are.
---
 src/memes.js       |  6 +++++-
 staging/index.html | 13 +++++++++----
 2 files changed, 14 insertions(+), 5 deletions(-)

diff --git a/src/memes.js b/src/memes.js
index d4e7cb6..a09dc3a 100644
--- a/src/memes.js
+++ b/src/memes.js
@@ -22,10 +22,14 @@
 })(typeof globalThis !== 'undefined' ? globalThis : this, function createShapeyMemes(root) {
   'use strict';
 
+  // The staging page sets window.SHAPEY_ENV = { memesStandardWindow: 3 } to fire commentary a
+  // little more often while testing. Every other page (and Node, in the tests) keeps the default.
+  const envWindow = Number(root && root.SHAPEY_ENV && root.SHAPEY_ENV.memesStandardWindow);
+
   const CONFIG = Object.freeze({
     assetBase: 'assets/memes',
     manifestUrl: 'assets/memes/manifest.json',
-    standardWindow: 4,   // one win/lose meme per four attempts, per human player
+    standardWindow: Number.isFinite(envWindow) && envWindow > 0 ? envWindow : 4, // one win/lose meme per this many attempts, per human player
     tagWinWindow: 4,     // Tag: one team-win meme per this many attempts, per human player
     delayAtMs: 10000,    // Delay meme when this much of an idle player's pick countdown is left
     maxAudioMs: 5000,    // audio memes never play longer than this
diff --git a/staging/index.html b/staging/index.html
index 058b047..3c34b63 100644
--- a/staging/index.html
+++ b/staging/index.html
@@ -23,7 +23,7 @@
 
     /* Shown instantly, while Phaser itself is still downloading. It uses the same layout as the in-game
        loading screen (a 720 x 1280 stage, logo centred at 470, load bar centred at 720), so the hand-over is seamless.
-       Keep these numbers in sync with LOGO_* / LOAD_BAR_* in src/main.js. */
+       Keep these numbers in sync with LOGO_* / LOAD_BAR_* in src/constants.js. */
     #boot { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; }
     #boot .stage { position: relative; width: min(100vw, 56.25vh); height: min(177.78vw, 100vh); }
     #boot img { position: absolute; left: 50%; transform: translate(-50%, -50%); height: auto; }
@@ -58,10 +58,15 @@
     <div class="bar"><img id="bootLoadRectangle" alt="" width="840" height="175" /><div class="fill"><div class="gloss"></div></div></div>
   </div></div>
   <div id="game"></div>
-  <script src="staging/loading-bar.js"></script>
+  <!-- Staging runs the same src/ modules as production (no forked copies). SHAPEY_ENV, read by
+       src/config.js and src/memes.js, marks this page as staging: it allows the local-Worker
+       ?api=http://localhost:8787 override from any host and fires meme commentary a little more
+       often (one per 3 attempts instead of 4) for testing. The banner above marks the page visually. -->
+  <script>window.SHAPEY_ENV = { staging: true, memesStandardWindow: 3 };</script>
+  <script src="src/loading-bar.js"></script>
   <script src="https://cdnjs.cloudflare.com/ajax/libs/phaser/3.80.1/phaser.min.js"></script>
   <script src="src/rules.js"></script>
-  <script src="staging/memes.js"></script>
-  <script src="staging/main.js"></script>
+  <script src="src/memes.js"></script>
+  <script type="module" src="src/main.js"></script>
 </body>
 </html>
