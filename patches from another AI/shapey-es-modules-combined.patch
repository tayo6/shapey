+// Unit tests for src/trackers.js (Countdown, RevealTracker, InventoryLimiter).
+// All three take an injected clock, so time is simulated exactly.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { Countdown, RevealTracker, InventoryLimiter } from '../src/trackers.js';
+
+// A controllable clock: a closure (not a method) so it survives being passed around.
+function fakeClock(startAt = 0) {
+  const state = { now: startAt };
+  return { state, fn: () => state.now };
+}
+
+test('Countdown tracks its deadline and expires exactly at it', () => {
+  const { state, fn } = fakeClock(1000);
+  const c = new Countdown(fn);
+  assert.equal(c.expired(), true, 'a fresh countdown has never started');
+  c.start(5000);
+  assert.equal(c.expired(), false);
+  assert.equal(c.remaining(), 5000);
+  state.now = 5000; // 4s later
+  assert.equal(c.remaining(), 1000);
+  assert.equal(c.expired(), false);
+  state.now = 6000;
+  assert.equal(c.expired(), true);
+  assert.equal(c.remaining(), 0, 'remaining never goes negative');
+});
+
+test('Countdown.stop parks the outgoing clock at the submit instant', () => {
+  // Used by submit(): the outgoing player's clock must not consume the time spent
+  // resolving the move, so stop() pins the deadline to now. From that moment the
+  // countdown reads zero/expired and never shows time again until a new start().
+  const { state, fn } = fakeClock(0);
+  const c = new Countdown(fn);
+  c.start(10000);
+  state.now = 4000;
+  c.stop();
+  assert.equal(c.remaining(), 0);
+  assert.equal(c.expired(), true);
+  state.now = 9000; // resolution takes another 5s...
+  assert.equal(c.remaining(), 0, 'the parked clock does not run down further');
+  assert.equal(c.expired(), true);
+  c.start(3000); // the next player gets a fresh deadline
+  assert.equal(c.remaining(), 3000);
+  assert.equal(c.expired(), false);
+});
+
+test('RevealTracker reports the longest remaining reveal and hands due batches back once', () => {
+  const { state, fn } = fakeClock(0);
+  const t = new RevealTracker(fn);
+  const opening = [{ id: 1 }, { id: 2 }];
+  const spawned = [{ id: 3 }];
+  t.add(opening, 15000, true);
+  state.now = 10000; // 5s before the opening flips, a spawned tile appears
+  t.add(spawned, 5000, true);
+  assert.equal(t.remaining(), 5000);
+  state.now = 15000;
+  assert.equal(t.remaining(), 0);
+  const due = t.takeDue();
+  assert.equal(due.length, 2);
+  assert.deepEqual(due[0].tiles, opening);
+  assert.equal(due[0].shuffle, true);
+  assert.equal(due[1].tiles[0].id, 3);
+  assert.deepEqual(t.takeDue(), [], 'a due batch is removed when taken');
+  assert.equal(t.remaining(), 0);
+});
+
+test('RevealTracker.cancelShuffles keeps flipping but stops shuffling', () => {
+  const { state, fn } = fakeClock(0);
+  const t = new RevealTracker(fn);
+  t.add([{ id: 1 }], 1000, true);
+  t.cancelShuffles();
+  state.now = 1000;
+  const [batch] = t.takeDue();
+  assert.equal(batch.shuffle, false, 'pending batches flip face-down but are no longer shuffled');
+});
+
+test('InventoryLimiter enforces a rolling per-player window', () => {
+  const { state, fn } = fakeClock(0);
+  const limiter = new InventoryLimiter(2, 60000, 2, fn);
+  assert.deepEqual(limiter.tryOpen(0), { allowed: true, left: 1, retryInMs: 0 });
+  state.now = 5000;
+  assert.deepEqual(limiter.tryOpen(0), { allowed: true, left: 0, retryInMs: 0 });
+  const refused = limiter.tryOpen(0);
+  assert.equal(refused.allowed, false);
+  assert.ok(refused.retryInMs > 0 && refused.retryInMs <= 60000);
+  // The other player has their own budget.
+  assert.equal(limiter.tryOpen(1).allowed, true);
+  // At 60.001s the first open (t=0) has rolled out of the window, the second (t=5s) is still in.
+  state.now = 60001;
+  assert.equal(limiter.tryOpen(0).allowed, true);
+  assert.equal(limiter.tryOpen(0).allowed, false); // the t=5s open is still inside the window
+  // At 65.001s that one has rolled out too.
+  state.now = 65001;
+  assert.equal(limiter.tryOpen(0).allowed, true);
+});
+
+test('InventoryLimiter refused opens are not recorded', () => {
+  const { state, fn } = fakeClock(0);
+  const limiter = new InventoryLimiter(1, 1000, 1, fn);
+  limiter.tryOpen(0);
+  for (let i = 0; i < 5; i++) assert.equal(limiter.tryOpen(0).allowed, false);
+  state.now = 1001; // window passed; the refusals did not extend it
+  assert.equal(limiter.tryOpen(0).allowed, true);
+});
diff --git a/tests/utils.test.mjs b/tests/utils.test.mjs
new file mode 100644
index 0000000..c5ebbd0
--- /dev/null
+++ b/tests/utils.test.mjs
@@ -0,0 +1,88 @@
+// Unit tests for src/utils.js (pure helpers: shuffle, randomItem, formatClock,
+// planShuffle, randomBoardShape). Run with: node --test tests/
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { shuffle, randomItem, formatClock, planShuffle, randomBoardShape } from '../src/utils.js';
+import { SHAPE_KEYS, DUMMY_SPAWN_CHANCE, SHUFFLE_SKIP_CHANCE } from '../src/constants.js';
+
+// Deterministic PRNG (mulberry32) so shuffle/planShuffle tests are reproducible.
+function seeded(seed) {
+  let a = seed >>> 0;
+  return () => {
+    a |= 0; a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+test('shuffle returns a permutation without mutating the input', () => {
+  const input = [1, 2, 3, 4, 5, 6, 7, 8];
+  const copy = input.slice();
+  const out = shuffle(input);
+  assert.deepEqual(input, copy, 'input must not be mutated');
+  assert.deepEqual([...out].sort((a, b) => a - b), copy, 'output is a permutation');
+});
+
+test('shuffle of empty and single-element lists is safe', () => {
+  assert.deepEqual(shuffle([]), []);
+  assert.deepEqual(shuffle(['x']), ['x']);
+});
+
+test('randomItem returns a member of the list', () => {
+  const list = ['a', 'b', 'c'];
+  for (let i = 0; i < 20; i++) assert.ok(list.includes(randomItem(list)));
+});
+
+test('formatClock rounds up, clamps at zero and pads to MM:SS', () => {
+  assert.equal(formatClock(0), '00:00');
+  assert.equal(formatClock(-5000), '00:00');      // never negative
+  assert.equal(formatClock(45000), '00:45');
+  assert.equal(formatClock(44001), '00:45');      // rounds up
+  assert.equal(formatClock(59999), '01:00');      // 59.999s rounds up to a minute
+  assert.equal(formatClock(60000), '01:00');
+  assert.equal(formatClock(3661000), '61:01');    // minutes are not capped at 59
+});
+
+test('planShuffle: fewer than 2 tiles plans nothing', () => {
+  assert.deepEqual(planShuffle(0), { steps: [], skipped: [] });
+  assert.deepEqual(planShuffle(1), { steps: [], skipped: [] });
+});
+
+test('planShuffle: N tiles give N-1 valid swap steps', () => {
+  for (const count of [2, 3, 4, 5, 8]) {
+    const rng = seeded(count * 7919);
+    const { steps, skipped } = planShuffle(count, rng, SHUFFLE_SKIP_CHANCE);
+    assert.equal(steps.length, count - 1, `${count} tiles`);
+    for (const [a, b] of steps) {
+      assert.ok(a !== b, 'a swap never pairs a tile with itself');
+      assert.ok(a >= 0 && a < count && b >= 0 && b < count, 'indexes stay inside the batch');
+    }
+    for (const i of skipped) assert.ok(i >= 0 && i < count);
+    // Same seed, same plan: the planner is fully driven by the injected rng.
+    assert.deepEqual(planShuffle(count, seeded(count * 7919), SHUFFLE_SKIP_CHANCE), { steps, skipped });
+  }
+});
+
+test('planShuffle: skipChance 0 involves everyone, skipChance 1 still involves at least 3', () => {
+  const none = planShuffle(5, seeded(1), 0);
+  assert.equal(none.skipped.length, 0);
+  assert.equal(none.steps.length, 4);
+  const all = planShuffle(5, seeded(2), 1);
+  // Every tile rolled a skip, but the minimum-player rule pulls (up to) 3 back in.
+  assert.ok(all.skipped.length <= 2, 'at most 2 of 5 tiles sit out when everything rolls a skip');
+  assert.equal(all.steps.length, 4);
+});
+
+test('randomBoardShape returns a dummy DUMMY_SPAWN_CHANCE-share of the time', () => {
+  const realRandom = Math.random;
+  try {
+    Math.random = () => 0; // below every threshold -> dummy
+    assert.equal(randomBoardShape(), 'dummy');
+    Math.random = () => 0.999; // above the dummy chance -> a spawnable shape key
+    assert.ok(SHAPE_KEYS.includes(randomBoardShape()));
+    assert.notEqual(randomBoardShape(), 'dummy');
+  } finally {
+    Math.random = realRandom;
+  }
+});
