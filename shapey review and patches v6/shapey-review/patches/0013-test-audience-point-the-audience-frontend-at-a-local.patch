+    await audienceB.locator("#watchView:not([hidden])").waitFor({ state: "attached", timeout: 15_000 });
+    await audienceB.waitForFunction(() =>
+      !document.getElementById("veil").checkVisibility(), null, { timeout: 15_000 });
