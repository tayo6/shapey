+    {
+      const [a, b] = await Promise.all([readScene(page1), readScene(page2)]);
+      for (const [scene, label] of [[a, "Player 1"], [b, "Player 2"]]) {
+        assert.ok(scene.turnRemaining !== null && scene.turnRemaining > 0,
