+    await clickWorld(page1, 360, 885); // the CLOSE RESULTS button
+    await waitForScene(page1, () =>
+      !(window.game?.scene?.getScene("GameScene")?.pollUI || []).length,
+      "poll results overlay dismissed", 5_000);
+    for (let index = 1; index < 3; index++) {
