From ff7f7f2935527d559e946730722c776de497941a Mon Sep 17 00:00:00 2001
From: Shapey Review <review@shapey.local>
Date: Fri, 23 Oct 2026 20:08:31 +0000
Subject: [PATCH 03/11] fix(ai): lower AI_SPARE_MS below the AI's 5-second turn

AI_TURN_MS is 5000 but AI_SPARE_MS was 6000, so
'turnClock.remaining() < AI_SPARE_MS' in aiAttempt() was true from the
first frame of every AI turn. The AI therefore always stopped at a
3-tile match: the Professional level's documented 'reaches for 5
tiles' behaviour (AI_LEVELS.pro.goBig, GAMEPLAY.md) could never run.

Lower the spare threshold to 2000ms so Professional can build bigger
matches during the first ~3 seconds of its turn, and update
GAMEPLAY.md, which described the old 6-second threshold.
---
 GAMEPLAY.md      | 2 +-
 src/constants.js | 5 ++++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/GAMEPLAY.md b/GAMEPLAY.md
index 7d60980..ed1ebd4 100644
--- a/GAMEPLAY.md
+++ b/GAMEPLAY.md
@@ -96,7 +96,7 @@ The starting board gets about that share of hazards, and every newly spawned til
 | Reaches for | 3 tiles, sometimes 4 | 5 tiles (the 5+ score) |
 | With no full match remembered | guesses | starts from the shape it remembers most copies of, then explores tiles it has no memory of |
 
-Neither level reaches for a bigger match when under 6 seconds of the turn is left (`AI_SPARE_MS`). The AI keeps acting during its turn until it submits a match, makes a real mismatch, or the clock expires. At timeout, any valid selected match auto-submits. Double Play is usable by a human player; other power-up effects are not yet active.
+Neither level reaches for a bigger match when under 2 seconds of the turn is left (`AI_SPARE_MS`; the AI itself plays a fixed 5-second turn, `AI_TURN_MS`). The AI keeps acting during its turn until it submits a match, makes a real mismatch, or the clock expires. At timeout, any valid selected match auto-submits. Double Play is usable by a human player; other power-up effects are not yet active.
 
 **Easy**
 - Remembers roughly 45–60% of the tiles it saw, with intentional memory mistakes.
diff --git a/src/constants.js b/src/constants.js
index 23e9bc2..70edb20 100644
--- a/src/constants.js
+++ b/src/constants.js
@@ -68,7 +68,10 @@ export const AI_LEVELS = {
           thinkMs: 900, tapMs: [450, 800], gapMs: 400, submitMs: 450, maxAttempts: 5,
           bestGroupChance: 1, goBig: true, followHunch: true, preferUnknown: true },
 };
-export const AI_SPARE_MS = 6000; // the AI stops reaching for a bigger match when this little of its turn is left
+// Must stay below AI_TURN_MS (the AI's fixed 5-second turn): with 6000 the spare-time
+// check in aiAttempt() was always true, so the AI never reached past a 3-tile match
+// and the Professional "goes for 5" behaviour (AI_LEVELS.pro.goBig) was dead code.
+export const AI_SPARE_MS = 2000; // the AI stops reaching for a bigger match when this little of its turn is left
 
 // texture key -> file in assets/shapes
 export const SHAPE_FILES = {
