From a55316974707475ea5d5aa95ba8c5d5ab8dd0f6b Mon Sep 17 00:00:00 2001
From: Shapey Review <review@shapey.local>
Date: Fri, 23 Oct 2026 20:14:06 +0000
Subject: [PATCH 06/11] fix(game): destroy the board mask Graphics on scene
 shutdown

createBoard() builds its geometry mask from a Graphics object created
with add:false, so it is not part of the scene's display list and
Phaser does not destroy it when GameScene shuts down or restarts
(Play Again / Restart both call scene.restart). Each restart leaked
one Graphics object plus its geometry mask for the lifetime of the
page. Destroy both in a shutdown handler.
---
 src/scenes/game.js | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/scenes/game.js b/src/scenes/game.js
index 50f563c..da0d05b 100644
--- a/src/scenes/game.js
+++ b/src/scenes/game.js
@@ -1040,6 +1040,13 @@ export class GameScene extends Phaser.Scene {
       GRID_ROWS * TILE_PITCH + 4
     );
     this.boardMask = maskGfx.createGeometryMask();
+    // The mask graphics are created with add:false, so Phaser's scene shutdown never destroys
+    // them. Clean them up here or every restart of this scene leaks one Graphics object
+    // (and its WebGL buffers) for the lifetime of the page.
+    this.events.once('shutdown', () => {
+      try { this.boardMask.destroy(); } catch {}
+      try { maskGfx.destroy(); } catch {}
+    });
 
     if (this.online) {
       this.tiles = Array.from({ length: GRID_ROWS }, () => Array(GRID_COLS).fill(null));
