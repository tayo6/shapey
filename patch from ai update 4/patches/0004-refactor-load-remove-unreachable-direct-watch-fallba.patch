-        let message;
-        try { message = JSON.parse(event.data); } catch { return; }
-        const isStartMessage = (message.type === 'spectator_welcome' || message.type === 'game_started' ||
-          message.type === 'game_state') && message.state;
-        if (message.type === 'error' && !started) {
