From f9d08bce1655d90a85b356d57d08e6b17e00abe7 Mon Sep 17 00:00:00 2001
From: Shapey Review <review@shapey.local>
Date: Fri, 23 Oct 2026 20:11:41 +0000
Subject: [PATCH 04/11] refactor(load): remove unreachable direct-watch
 fallback in startAudienceWatch

startAudienceWatch() redirects non-embedded ?watch= visitors to
staging/audience.html (embed !== '1' returns early), and the remaining
path is by definition embed === '1'. The trailing 44-line
'Direct watch links remain supported outside the embedded audience
layout' block could therefore never execute: its fetch + WebSocket
connection, error handling and scene handoff were dead code.

Drop the block, unwrap the now-redundant embed check, and stop
importing MULTIPLAYER_API, which only the dead code used.
---
 src/scenes/load.js | 50 ++++------------------------------------------
 1 file changed, 4 insertions(+), 46 deletions(-)

diff --git a/src/scenes/load.js b/src/scenes/load.js
index 1d9db1b..7707aad 100644
--- a/src/scenes/load.js
+++ b/src/scenes/load.js
@@ -7,7 +7,7 @@
 // font load never blocks the game for more than 2.5 seconds.
 
 import { GAME_WIDTH, GAME_HEIGHT, FONT, SHAPE_FILES, LOGO_W, LOGO_Y, LOAD_BAR_W, LOAD_BAR_Y, LOAD_TRACK, LOAD_MIN_FILL } from '../constants.js';
-import { urlParams, MULTIPLAYER_API, AUDIENCE_WATCH_CODE, START_MODE } from '../config.js';
+import { urlParams, AUDIENCE_WATCH_CODE, START_MODE } from '../config.js';
 
 const fontReady = Promise.race([
   document.fonts.load(`20px ${FONT}`),
@@ -120,7 +120,9 @@ export class LoadScene extends Phaser.Scene {
 
     // Embedded audience page owns the single real WebSocket. The iframe receives the same
     // authorised spectator snapshots through postMessage, so each watcher counts only once.
-    if (urlParams.get('embed') === '1') {
+    // (This scene only ever runs embedded: the non-embedded ?watch= case was redirected to
+    // staging/audience.html above, so no direct-connection fallback is needed here.)
+    {
       class EmbeddedAudienceSocket extends EventTarget {
         constructor() {
           super();
@@ -171,49 +173,5 @@ export class LoadScene extends Phaser.Scene {
       });
       return;
     }
